# Endereço PostgreSQL fornecido pela Aiven. Nunca envie o valor real ao repositório.
DATABASE_URL=postgres://usuario:senha@host.aivencloud.com:porta/defaultdb

# Conteúdo completo do certificado CA da Aiven. No Render, cole como variável secreta.
# Quebras de linha reais ou a sequência \n são aceitas.
AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Endereço público final, sem barra no fim. Exemplo: https://minha-apostila.onrender.com
PUBLIC_ORIGIN=http://localhost:3000

PORT=3000
NODE_ENV=development
SESSION_DAYS=30
DATABASE_POOL_MAX=3
