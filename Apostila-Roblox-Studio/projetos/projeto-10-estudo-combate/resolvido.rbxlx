  <Item class="StarterPack"><Properties><string name="Name">StarterPack</string></Properties><Item class="Tool"><Properties><string name="Name">Blaster</string><bool name="RequiresHandle">false</bool></Properties><Item class="LocalScript"><Properties><string name="Name">Projeto10Client</string><ProtectedString name="Source"><![CDATA[--!strict
local remote = game:GetService("ReplicatedStorage").Remotes.RequestFire
local tool = script.Parent
tool.Activated:Connect(function()
 local camera = workspace.CurrentCamera
 if camera then remote:FireServer(camera.CFrame.LookVector) end
end)
]]></ProtectedString></Properties></Item></Item></Item>
